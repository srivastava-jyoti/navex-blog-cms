{
  "name": "navex-blog-cms",
  "private": true,
  "version": "1.0.0",
  "description": "Blog CMS: Sanity Studio content rendered by Hugo",
  "type": "module",
  "scripts": {
    "fetch": "tsx scripts/fetch-sanity.ts",
    "dev": "npm run fetch && hugo server --source web",
    "build": "npm run fetch && hugo --source web --minify",
    "test": "tsx --test scripts/**/*.test.ts",
    "typecheck": "tsc --noEmit -p scripts",
    "studio": "npm --prefix studio run dev"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@sanity/client": "8.9.0",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
